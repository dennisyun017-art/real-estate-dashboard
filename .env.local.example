# 국토교통부 실거래가 API 인증키 (Encoding 버전 그대로 복사)
MOLIT_API_KEY=

# Supabase 프로젝트 설정 (Project Settings > API 에서 확인)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 대시보드 공유 비밀번호 (가족/지인에게 알려줄 값)
DASHBOARD_PASSWORD=

# 세션 쿠키 서명용 임의의 긴 문자열 (아무 랜덤 문자열이면 됩니다)
SESSION_SECRET=

# /api/collect 를 Vercel Cron 이외의 경로로 실수로 호출하지 못하도록 보호하는 값
# (Vercel Cron은 자동으로 이 값을 Authorization: Bearer 헤더에 실어 보냅니다 - vercel.json 참고)
CRON_SECRET=
